# ==============================================================================
# Harsh AI Video Studio - Master Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your current target environment.
# Supported Deployments:
#   1. development (Antigravity Laptop - Control plane & UI dev, no GPU needed)
#   2. remote-gpu  (Rented GPU server - Real Wan 2.2 + LightX2V execution)
#   3. local-gpu   (Dedicated RTX 5090 production server)
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="Harsh AI Video Studio"
APP_VERSION=1.0.0
DEBUG=true
PORT=8000
HOST=0.0.0.0

# GPU Execution Architecture Mode
# Options:
#   remote: Laptop sends job requests to Rented GPU Server
#   local:  Direct execution on current machine (used on Rented GPU or RTX 5090 Server)
GPU_MODE=remote

# AI Video Generation Engine
# Options:
#   lightx2v: LightX2V acceleration (NVFP4, Sparse Attention, RTX Blackwell / 50-series)
#   wan22:    Wan 2.2 I2V A14B standard pipeline
ENGINE=lightx2v

# Remote GPU Server Connectivity (Active when GPU_MODE=remote)
GPU_SERVER_URL=https://gpu.your-rented-server.com:8000
GPU_SERVER_TIMEOUT_SECONDS=600

# Security & API Authentication
API_KEY=harsh_studio_secure_dev_key_change_in_production
SECRET_KEY=generate_a_random_32_byte_secret_for_jwt_and_signing
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage & Directory Roots (Configurable paths)
# For Linux / Remote GPU use: /workspace/models, /workspace/projects, etc.
# For Windows Dev use relative or absolute paths:
MODEL_ROOT=./models
PROJECT_ROOT=./projects
OUTPUT_ROOT=./outputs
CACHE_ROOT=./cache

# Database Configuration
# Dev default: SQLite; Production: PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./studio.sqlite3
# DATABASE_URL=postgresql+asyncpg://harsh_user:secure_password@localhost:5432/harsh_video_studio

# Job Queue & Broker (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=video_generation_jobs
REDIS_QC_QUEUE_NAME=video_qc_jobs
REDIS_RENDER_QUEUE_NAME=video_render_jobs

# LightX2V Engine Parameters (Target: RTX 5090 / Rented GPU)
LIGHTX2V_PRECISION=nvfp4
LIGHTX2V_SPARSE_ATTENTION=true
LIGHTX2V_ATTENTION_HEAD_RATIO=0.75
LIGHTX2V_USE_CUDA_GRAPH=true
LIGHTX2V_OFFLOAD_CPU=false
LIGHTX2V_MAX_BATCH_SIZE=1

# Wan 2.2 Model Configuration
WAN22_MODEL_NAME=Wan2.2-I2V-14B-720P
WAN22_CHECKPOINT_DIR=./models/Wan2.2-I2V-14B-720P
WAN22_DEFAULT_STEPS=30
WAN22_DEFAULT_GUIDANCE_SCALE=5.0
WAN22_DEFAULT_FPS=24
WAN22_DEFAULT_RESOLUTION=1280x720

# Character Consistency & Automated QC Engine
MAX_REGENERATION_ATTEMPTS=3
QC_FACE_SIMILARITY_THRESHOLD=0.75
QC_BLACK_FRAME_TOLERANCE_PCT=0.01
QC_MIN_AUDIO_VIDEO_SYNC_MS=50
QC_ENABLE_AUTO_RETRY=true

# Video Processing & FFmpeg
FFMPEG_BINARY_PATH=ffmpeg
FFPROBE_BINARY_PATH=ffprobe
DEFAULT_VIDEO_CODEC=libx264
DEFAULT_AUDIO_CODEC=aac
DEFAULT_RENDER_FPS=24
TARGET_FINAL_RESOLUTION=1920x1080

# Voice & Lip-Sync Modules
DEFAULT_TTS_PROVIDER=modular_tts
DEFAULT_LIPSYNC_PROVIDER=modular_lipsync
VOICE_REFERENCE_CACHE=./cache/voices
