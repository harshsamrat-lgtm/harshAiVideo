# ==============================================================================
# Harsh AI Video Studio - Web UI Dockerfile (Next.js / Node)
# ==============================================================================
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

RUN npm install

# Copy source
COPY . .

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["npm", "run", "dev"]
